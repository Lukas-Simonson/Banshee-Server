meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseURL}}/api/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # Login
  
  This endpoint is used to get an authorization token by using a provided Username and Password
}
