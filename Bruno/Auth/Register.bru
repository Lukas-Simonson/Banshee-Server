meta {
  name: Register
  type: http
  seq: 2
}

post {
  url: {{baseURL}}/api/auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}",
    "role": "{{role}}"
  }
}

vars:pre-request {
  role: admin
}

settings {
  encodeUrl: true
  timeout: 0
}
